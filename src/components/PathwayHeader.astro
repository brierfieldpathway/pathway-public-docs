---
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="pathway-topbar">
  <div class="pathway-topinner">
    <a class="pathway-brand" href={base + '/'} aria-label="Brierfield Pathway home">
      <img class="pathway-brand-mark" src={base + '/brand/pathway-mark.webp'} width="42" height="42" alt="" />
      <span class="pathway-brand-copy"><strong>Brierfield Pathway</strong><small>Documentation and help centre</small></span>
    </a>
    <nav class="pathway-main-nav" aria-label="Main navigation">
      <a href={base + '/'}>Home</a>
      <a href={base + '/#pathway-organisations'}>Browse</a>
      <a href={base + '/labs/public-projects/'}>Guides</a>
      <a href={base + '/#pathway-tasks'}>By task</a>
      <a href={base + '/about/'}>About</a>
    </nav>
    <div class="pathway-header-right">
      <div class="pathway-header-search"><Search /></div>
      <div class="pathway-theme"><ThemeSelect /></div>
      <span class="pathway-public-label">Public site</span>
    </div>
  </div>
  <div class="pathway-header-notice">PUBLIC PREVIEW · Curated public information only · Private documentation remains separate</div>
</div>

<style>
  .pathway-topbar { width: 100%; height: 100%; background: var(--pathway-card); color: var(--pathway-heading); }
  .pathway-topinner {
    max-width:1380px; margin:0 auto; padding:0 32px; height:78px;
    display:flex;align-items:center;gap:25px;
  }
  .pathway-brand {
    display:flex; align-items:center; gap:12px; font-size:22px;
    font-weight:770; letter-spacing:-.045em; white-space:nowrap;
    text-decoration:none; color:var(--pathway-heading);
  }
  .pathway-brand-mark {width:42px;height:42px;flex:none;object-fit:contain;}
  .pathway-brand-copy {display:flex;flex-direction:column;gap:1px;}
  .pathway-brand-copy strong {font:700 1.25rem/1.06 Georgia,'Times New Roman',serif;letter-spacing:-.025em;}
  .pathway-brand-copy small {font:400 .61rem/1.1 ui-sans-serif,system-ui,sans-serif;letter-spacing:0;color:var(--pathway-muted);}
  .pathway-main-nav {display:flex;align-items:center;gap:22px;margin-left:22px;white-space:nowrap;}
  .pathway-main-nav a {color:var(--pathway-heading);font-weight:650;text-decoration:none;font-size:.9rem;padding:8px 0;}
  .pathway-main-nav a:hover {color:var(--pathway-link);}
  .pathway-header-right {display:flex;align-items:center;gap:12px;margin-left:auto;min-width:0;}
  .pathway-header-search {width:235px;max-width:100%;}
  .pathway-header-right :global(site-search button[data-open-modal]) {
    width:100%;min-height:43px; border:1px solid var(--pathway-line);border-radius:11px;
    background:var(--sl-color-bg);color:var(--pathway-muted);padding:.55rem .75rem; font-size:.87rem;
  }
  .pathway-theme {min-width:78px;}
  .pathway-public-label {font-size:.77rem;font-weight:650;border:1px solid var(--pathway-line);border-radius:11px;white-space:nowrap;padding:10px 11px;color:var(--pathway-muted);}
  .pathway-header-notice {display:flex;align-items:center;justify-content:center;height:31px;background:var(--pathway-banner);color:var(--pathway-banner-text);font-size:12px;line-height:1.25;text-align:center;padding:5px 16px;border-block:1px solid var(--pathway-line);}
  a:focus-visible {outline:3px solid #70c9e5;outline-offset:3px;border-radius:4px;}
  @media(max-width:1160px) {
    .pathway-topinner {gap:16px;}
    .pathway-main-nav {gap:12px;margin-left:0;}
    .pathway-main-nav a {font-size:.85rem;}
    .pathway-header-search {width:175px;}
    .pathway-brand {font-size:19px;}
    .pathway-public-label {display:none;}
  }
  @media(max-width:850px) {
    .pathway-topinner {height:149px;align-content:center;flex-wrap:wrap;gap:10px 14px;padding:9px 18px;}
    .pathway-brand {font-size:20px;width:100%;}
    .pathway-header-right {order:2;margin-left:auto;width:100%;justify-content:flex-end;}
    .pathway-header-search {width:auto;display:none;}
    .pathway-header-right :global(site-search button[data-open-modal]) {border:0;width:auto;background:transparent;padding:.35rem;}
    .pathway-theme {min-width:65px;}
    .pathway-public-label {display:inline-flex;}
    .pathway-main-nav {order:3;width:100%;padding-right:48px;justify-content:space-between;overflow-x:auto;gap:13px;}
    .pathway-main-nav a {font-size:.83rem;font-weight:700;}
    .pathway-header-notice {height:44px;}
  }
  @media(max-width:430px) {
    .pathway-topinner {padding-inline:15px;}
    .pathway-brand {font-size:18px;gap:9px;} .pathway-brand-copy strong {font-size:1.08rem;}
    .pathway-brand-mark {width:34px;height:34px;}
    .pathway-main-nav a {font-size:.76rem;}
    .pathway-theme {min-width:61px;}
    .pathway-header-notice {font-size:11px;}
  }
</style>