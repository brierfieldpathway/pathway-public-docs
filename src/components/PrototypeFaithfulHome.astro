---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const areas = [
  { id: 'labs', title: 'Brierfield Labs', icon: '⚙', description: 'Software development, infrastructure and technical reference.', href: base + '/labs/' },
  { id: 'publishing', title: 'Brierfield Publishing', icon: 'book-open', description: 'Publishing projects, workflows and public resources.', href: base + '/publishing/' },
  { id: 'inner', title: 'Inner Pathway', icon: '♡', description: 'The independent counselling practice and its public information.', href: base + '/inner-pathway/' },
  { id: 'shared', title: 'Shared Services', icon: '↗', description: 'Workstations, tools and approved common information.', href: base + '/shared-services/' },
];
const tasks = [
  { title: 'Getting started', icon: '↗', description: 'Find your area and the public starting points.', href: base + '/start-here/' },
  { title: 'Everyday tasks', icon: '▤', description: 'Find useful public projects and references.', href: base + '/labs/public-projects/' },
  { title: 'Troubleshooting', icon: '✳', description: 'Find support and public project issue trackers.', href: 'https://github.com/brierfieldlabs/xabl/issues' },
  { title: 'Recovery', icon: '◇', description: 'Sensitive recovery instructions remain private.', href: base + '/shared-services/', id:'pathway-recovery' },
];
const resources = [
  { title: 'Explore XABL', desc: 'xBase-compatible language and development tools.', icon: '⌘', organisation: 'Brierfield Labs', href: 'https://github.com/brierfieldlabs/xabl' },
  { title: 'XABL Text Studio', desc: 'Public documentation for the terminal IDE.', icon: '▤', organisation: 'Brierfield Labs', href: 'https://github.com/brierfieldlabs/xabl/blob/main/docs/user/text-studio.md' },
  { title: 'XABL architecture', desc: 'Published design decisions and technical notes.', icon: '⚙', organisation: 'Brierfield Labs', href: 'https://github.com/brierfieldlabs/xabl/blob/main/docs/developer/architecture/xabl-design-decisions.md' },
  { title: 'Pocket Casts Android', desc: 'Source code for the public Android fork.', icon: '◉', organisation: 'Brierfield Labs', href: 'https://github.com/brierfieldlabs/pocket-casts-android' },
  { title: 'Brierfield Publishing website', desc: 'Public website source and development history.', icon: '▤', organisation: 'Brierfield Publishing', href: 'https://github.com/brierfieldlabs/brierfield-publishing-website' },
  { title: 'Inner Pathway Counselling', desc: 'Official information from the independent practice.', icon: '♡', organisation: 'Inner Pathway', href: 'https://innerpathway.co.uk' },
];
---

<div class="pathway-home">
  <section class="pathway-landscape" aria-labelledby="pathway-home-heading">
    <div class="landscape-overlay"></div>
    <div class="landscape-intro">
      <h1 id="pathway-home-heading">Welcome to<br />Brierfield Pathway</h1>
      <p>Shared documentation, guides and technical reference for our businesses and shared services.</p>
      <form class="landscape-search" id="pathway-hero-search" role="search">
        <label class="sr-only" for="pathway-search-term">Search public documentation</label>
        <span aria-hidden="true" class="search-glyph">⌕</span>
        <input id="pathway-search-term" type="search" placeholder="Search documentation, guides and references..." autocomplete="off" />
        <button type="submit">Search <span aria-hidden="true">→</span></button>
      </form>
    </div>
    <div class="areas" id="pathway-organisations">
      {areas.map((area) => (
        <a class={'area area-' + area.id} href={area.href}>
          <span class="area-symbol" aria-hidden="true">
            {area.icon === 'book-open' ? (
              <svg class="open-book" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8C12.2 5.7 8.6 5 3 5v20c5.2 0 9.2 1.1 13 3.4 3.8-2.3 7.8-3.4 13-3.4V5c-5.6 0-9.2.7-13 3Z"/>
                <path d="M16 8v20"/>
              </svg>
            ) : area.icon}
          </span>
          <h2>{area.title}</h2>
          <p>{area.description}</p>
          <span class="area-go" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="resource-section" id="pathway-resources" aria-labelledby="resource-title">
    <div class="section-heading">
      <h2 id="resource-title">Popular public resources</h2>
      <a href={base + '/labs/public-projects/'}>Browse public projects <span aria-hidden="true">→</span></a>
    </div>
    <div class="resource-grid">
      {resources.slice(0,4).map((resource) => (
        <a class="resource-card" href={resource.href}>
          <span class="resource-symbol" aria-hidden="true">{resource.icon}</span>
          <span class="resource-copy"><strong>{resource.title}</strong><small>{resource.organisation}</small></span>
          <span class="resource-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <div class="additional-resources">
      {resources.slice(4).map((resource) => (
        <a href={resource.href}>{resource.title} <span aria-hidden="true">↗</span></a>
      ))}
    </div>
  </section>

  <section class="resource-section tasks-section" id="pathway-tasks" aria-labelledby="task-title">
    <div class="section-heading">
      <h2 id="task-title">Browse by task</h2>
      <a href={base + '/start-here/'}>View all areas <span aria-hidden="true">→</span></a>
    </div>
    <div class="task-grid">
      {tasks.map((task) => (
        <a class="task-card" id={task.id} href={task.href}>
          <span class="task-icon" aria-hidden="true">{task.icon}</span>
          <strong>{task.title}</strong>
          <small>{task.description}</small>
          <span class="task-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <footer class="pathway-footer">Brierfield Pathway · Public preview · Curated public information only · Private documentation requires separate authorisation</footer>
</div>

<script>
  // Search is Starlight's real client-side Pagefind search; there is no separate index.
  function openSiteSearch(term: string) {
    const trigger = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
    if (!trigger || trigger.disabled) return;
    trigger.click();
    if (!term) return;
    let tries = 0;
    const putQuery = () => {
      const input = document.querySelector<HTMLInputElement>('site-search dialog input');
      if (input) {
        input.value = term;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();
      } else if (++tries < 25) {
        window.setTimeout(putQuery, 80);
      }
    };
    putQuery();
  }
  document.querySelector<HTMLFormElement>('#pathway-hero-search')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const term = document.querySelector<HTMLInputElement>('#pathway-search-term')?.value.trim() || '';
    openSiteSearch(term);
  });
</script>

<style>
  .pathway-home{max-width:1360px;margin:auto;padding:24px clamp(16px,2.4vw,32px) 0;color:var(--pathway-heading);}
  .pathway-home :is(h1,h2,p){margin:0}
  .pathway-home a{text-decoration:none;color:inherit}
  .pathway-home :is(a,button,input):focus-visible{outline:3px solid #3b91b1;outline-offset:3px}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  .pathway-landscape{position:relative;overflow:hidden;isolation:isolate;border-radius:16px;min-height:540px;padding:34px 24px 26px;background:linear-gradient(180deg,rgba(255,247,232,.72) 0%,rgba(255,246,231,.42) 41%,rgba(21,53,65,.16) 100%),url('/pathway-public-docs/brand/landscape-hero.jpg') center 46% /cover no-repeat;}
  .landscape-overlay{position:absolute;inset:0;pointer-events:none;z-index:-1;background:linear-gradient(180deg,rgba(245,250,248,.2),rgba(241,247,246,0) 54%,rgba(9,26,34,.06));}
  .landscape-intro{text-align:center;max-width:750px;margin:4px auto 0;color:#102f3f;}
  .landscape-intro h1{font:700 clamp(2.25rem,4.1vw,3.65rem)/1.09 Georgia,'Times New Roman',serif;letter-spacing:-.027em;color:#102f3f;text-shadow:0 1px 12px rgba(255,255,255,.55)}
  .landscape-intro p{max-width:640px;margin:15px auto 19px;font-size:clamp(.93rem,1.2vw,1.12rem);line-height:1.45;color:#153a4b;text-shadow:0 1px 12px rgba(255,255,255,.75)}
  .landscape-search{display:flex;gap:8px;align-items:center;padding:6px 6px 6px 18px;max-width:700px;margin:auto;border-radius:50px;background:#fff;border:1px solid #d8e2e5;box-shadow:0 8px 25px rgba(13,42,57,.16)}
  .search-glyph{font-size:1.65rem;line-height:1;color:#17657a}
  .landscape-search input{font:inherit;min-width:0;flex:1;background:transparent;color:#173340;border:none;outline:none;padding:10px 6px;}
  .landscape-search input::placeholder{color:#687b87}
  .landscape-search button{font:inherit;cursor:pointer;border:0;border-radius:32px;padding:12px 20px;background:#124c68;color:#fff;font-weight:730;white-space:nowrap}
  .landscape-search button:hover{background:#216b8b}
  .areas{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:42px;scroll-margin-top:12rem}
  .area{position:relative;display:flex;flex-direction:column;padding:19px 16px 15px;min-height:170px;border-radius:11px;background:rgba(255,255,255,.94);box-shadow:0 8px 24px rgba(18,48,61,.16);border:1px solid rgba(255,255,255,.82);transition:transform .15s ease,box-shadow .15s ease}
  .area:hover,.resource-card:hover,.task-card:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(18,48,61,.15)}
  .area-symbol{font-size:2rem;font-weight:600;line-height:1.1;color:#197ba8}
  .area-publishing .area-symbol{color:#cb923f}
  .area-symbol .open-book{display:block;width:33px;height:33px}
  .area-inner .area-symbol{color:#438d76}
  .area-shared .area-symbol{color:#287ba0}
  .area h2{font-size:1rem;line-height:1.25;margin-top:11px;font-weight:740;color:#183442;}
  .area p{font-size:.79rem;line-height:1.47;color:#5c7280;margin-top:6px;max-width:25ch}
  .area-go{position:absolute;right:14px;bottom:9px;color:#59788a}
  .resource-section{margin-top:30px;scroll-margin-top:12rem}
  .section-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px}
  .section-heading h2{font-size:1.35rem;font-weight:750;letter-spacing:-.025em}
  .section-heading a{font-size:.82rem;font-weight:700;color:var(--pathway-link)}
  .resource-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;}
  .resource-card{display:flex;align-items:center;gap:12px;min-height:100px;padding:14px;border:1px solid var(--pathway-line);background:var(--pathway-card);border-radius:12px;transition:transform .15s,box-shadow .15s}
  .resource-symbol{flex:none;font-size:1.65rem;color:var(--pathway-link)}
  .resource-copy{display:grid;gap:5px;flex:1;min-width:0}
  .resource-copy strong{font-size:.82rem;font-weight:700;line-height:1.33;color:var(--pathway-heading)}
  .resource-copy small{font-size:.7rem;color:var(--pathway-muted)}
  .resource-arrow{align-self:flex-end;color:var(--pathway-link)}
  .additional-resources{display:flex;flex-wrap:wrap;gap:10px 26px;margin-top:12px;font-size:.82rem}
  .additional-resources a{color:var(--pathway-link);font-weight:650}
  .task-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .task-card{min-height:156px;display:flex;flex-direction:column;position:relative;padding:17px;border:1px solid var(--pathway-line);background:var(--pathway-card);border-radius:12px;transition:transform .15s,box-shadow .15s}
  .task-icon{font-size:1.5rem;color:var(--pathway-link);margin-bottom:15px}
  .task-card strong{font-size:.95rem;margin-bottom:5px}
  .task-card small{font-size:.78rem;color:var(--pathway-muted);line-height:1.45;padding-bottom:13px}
  .task-arrow{position:absolute;right:15px;bottom:10px;color:var(--pathway-link)}
  .pathway-footer{border-top:1px solid var(--pathway-line);margin-top:28px;padding:25px 0 32px;font-size:.74rem;color:var(--pathway-muted)}
  :global(html[data-theme="dark"]) .pathway-landscape {
    background:linear-gradient(180deg,rgba(8,24,36,.87),rgba(9,27,40,.71) 55%,rgba(4,20,33,.91)),url('/pathway-public-docs/brand/landscape-hero.jpg') center 46% /cover no-repeat;
  }
  :global(html[data-theme="dark"]) .landscape-intro h1,
  :global(html[data-theme="dark"]) .landscape-intro p {color:#f3f9fa;text-shadow:0 1px 9px rgba(0,0,0,.4);}
  :global(html[data-theme="dark"]) .area {background:rgba(17,36,51,.94);border-color:rgba(90,124,139,.36);}
  :global(html[data-theme="dark"]) .area h2 {color:#f2f8fa;}
  :global(html[data-theme="dark"]) .area p {color:#cadbe1;}
  :global(html[data-theme="dark"]) .area-go {color:#9ac8db;}
  @media(max-width:950px){
    .areas,.resource-grid,.task-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .areas{margin-top:26px}
    .area{min-height:145px}
    .pathway-landscape{min-height:0}
  }
  @media(max-width:580px){
    .pathway-home{padding:10px 12px 0}
    .pathway-landscape{padding:24px 12px 17px;border-radius:13px;background-position:60% center}
    .landscape-intro h1{font-size:2rem}
    .landscape-intro p{font-size:.91rem}
    .landscape-search{padding:4px 5px 4px 11px;gap:3px}
    .landscape-search input{font-size:.78rem;padding:7px 2px}
    .landscape-search button{padding:9px 11px;font-size:.76rem}
    .areas{gap:8px;margin-top:22px}
    .area{padding:12px 10px 22px;min-height:169px}
    .area h2{font-size:.86rem;margin-top:6px}
    .area p{font-size:.73rem}
    .area-symbol{font-size:1.5rem}
    .area-symbol .open-book{width:26px;height:26px}
    .resource-grid,.task-grid{gap:8px}
    .resource-card{min-height:84px;padding:10px;gap:7px}
    .resource-symbol{font-size:1.35rem}
    .resource-copy strong{font-size:.74rem}
    .section-heading h2{font-size:1.15rem}
    .section-heading a{font-size:.74rem}
  }
  @media(max-width:340px){.areas,.resource-grid,.task-grid{grid-template-columns:1fr}.area{min-height:100px}}
  @media(prefers-reduced-motion:reduce){.area,.resource-card,.task-card{transition:none!important;transform:none!important}}
</style>
